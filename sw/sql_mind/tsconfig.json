{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./src/ts/dist",
    "rootDir": "./src/ts",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["jest", "node"],
    "moduleResolution": "bundler"
  },
  "include": ["src/ts/**/*"],
  "exclude": ["node_modules", "src/ts/dist"]
}